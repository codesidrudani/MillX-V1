{
  "name": "millx-desktop",
  "version": "1.0.0",
  "description": "MillX Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.millx.desktop",
    "productName": "MillX",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "loading.html"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist",
        "filter": ["**/*"]
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": true
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
